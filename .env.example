# Пароль входа в админку: /admin. Не короче 12 символов.
ADMIN_PASSWORD=change-me-now

# Секрет подписи сессии. Не короче 16 символов.
SESSION_SECRET=

# Ключ шифрования заявок и писем в data/. 32 байта в base64.
DATA_KEY=

# Ставьте 1 только если перед сайтом стоит свой обратный прокси.
# Без этого заголовок X-Forwarded-For от браузера игнорируется.
# TRUST_PROXY=1

# Почта для напоминаний. Пока поля пустые, письма с календарём
# сохраняются в data/outbox, а не уходят наружу.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Регистрация <events@example.com>"
